---
import { Image } from "astro:assets";
import "../styles/global.css";

type Props = {
    title?: string;
    description?: string;
    noindex?: boolean;
};

const {
    title = "袁某人主页 - MrYuan's Homepage",
    description = "袁某人的个性空间：嘿！很高兴遇见你。这是我的实时生存报告与人格画像。在这里，文字不只是记录，更是连接。翻翻博客，逛逛留言簿，让我们在这个简约的空间里，开启一场有趣的对话。",
    noindex = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const jsonLd = {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: "袁某人主页",
    url: Astro.site?.href,
    description,
    inLanguage: "zh-CN",
    author: { "@type": "Person", name: "袁某人", url: Astro.site?.href },
};
---

<!doctype html>
<html lang="zh-CN">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width,initial-scale=1" />
        <title>{title}</title>
        <meta name="description" content={description} />
        <meta name="author" content="袁某人" />
        {noindex ? (
            <meta name="robots" content="noindex, nofollow" />
        ) : (
            <Fragment>
                <meta name="robots" content="index, follow" />
                <link rel="canonical" href={canonical} />
                <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
            </Fragment>
        )}
        <link rel="icon" type="image/webp" href="/avatar.webp" />
    </head>
    <body ontouchstart="ontouchstart" class="bg-stone-50 text-stone-600 antialiased dark:bg-stone-900 dark:text-stone-400">

        <main class="mx-auto w-full max-w-2xl space-y-9 px-6 py-16 text-base leading-8 break-words">
			<Image src="/avatar.webp" alt="袁某人的头像" width={100} height={100} class="mb-10 size-6 rounded-full outline-2 outline-offset-2 outline-dashed outline-stone-200 dark:outline-stone-700"/>
            <slot />
		</main>

        {!import.meta.env.DEV && (
            <Fragment>
                <link rel="preconnect" href="https://stats.betterapi.net" />
                <script defer src="https://stats.betterapi.net/stats.js" data-website-id="d56426d4-f9ff-417a-8745-8eac7006c182"></script>
            </Fragment>
        )}

    </body>
</html>
