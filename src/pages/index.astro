---
import BaseLayout from "./layouts/BaseLayout.astro";

const label = "text-sm font-medium text-stone-400 dark:text-stone-500";

const myTags = ["废话输出机器🤐", "重度拖延症😪", "准时emo🌧️", "熬夜冠军🌠", "人之常情😍", "Need food🥣"];
---

<BaseLayout>
    <header class="space-y-1">
        <h1 class="font-semibold text-stone-900 dark:text-stone-100">👋 欢迎来访</h1>
        <p id="randTitle" class="text-stone-500 dark:text-stone-400"></p>
    </header>

    <div class="space-y-1 text-sm text-stone-500 dark:text-stone-400">
        <p>👀 你是第 <span id="currentViews" class="font-semibold tabular-nums text-stone-700 dark:text-stone-200">...</span> 位访客</p>
        <p>我正在：『<span id="currentStatus" class="text-stone-700 dark:text-stone-200">...</span>』</p>
    </div>

    <section class="space-y-2">
        <h2 class={label}>😉 关于我</h2>
        <p>我是一名极简主义者，喜欢用文字和 emoji 记录生活。</p>
    </section>

    <div class="flex items-center gap-2">
        <h2 class={label}>✍️ 留言簿</h2>
        <a href="https://jb18.cm/guestbook/" target="_blank" class="rounded-full bg-stone-200/70 px-2.5 py-0.5 text-xs tabular-nums text-stone-600 dark:bg-stone-800/60 dark:text-stone-300">
            <span id="commentsCount" class="underline underline-offset-2">...</span> 条记录
        </a>
    </div>

    <section class="space-y-3">
        <h2 class={label}>🏷️ 标签</h2>
        <div class="flex flex-wrap gap-2">
            {myTags.map((tag) => (
                <span class="rounded-full bg-stone-200/70 px-3 py-1 text-sm text-stone-600 dark:bg-stone-800/60 dark:text-stone-300">{tag}</span>
            ))}
        </div>
    </section>

    <a href="https://jb18.cm" target="_blank" class="block w-full border-t border-stone-200/70 pt-6 text-sm font-medium text-stone-700 underline-offset-4 hover:underline dark:border-stone-800 dark:text-stone-300">
        访问我的博客 <span class="text-stone-400">→</span>
    </a>
</BaseLayout>

<script>
    const titles = [
        "好久不见，今天过得开心吗？", "万物可爱，愿你今天也有一份好心情。", "这里的每一行字，都是送给你的礼物。",
        "停下来，吹吹风，看看这里的文字。", "保持好奇，世界比你想象的更宽广。", "万物皆有裂痕，那是光照进来的地方。",
        "在有限的时间里，去探索无限的可能。", "记录，是为了不被遗忘。", "你好，很高兴在这里与你思想共振。",
        "今天打算做点什么有趣的事？", "保持热爱，奔赴下一场山海。", "每一个不曾起舞的日子，都是对生命的辜负。",
        "既然来了，就多坐一会吧。", "在这里，发现文字的温度。", "生活碎片，都在这里拼凑完整。"
    ];
    const $ = (id: string) => document.getElementById(id)!;

    const title = sessionStorage.getItem("title") || titles[Math.floor(Math.random() * titles.length)];
    sessionStorage.setItem("title", title);
    $("randTitle").textContent = title;

    (async () => {
        let data = JSON.parse(sessionStorage.getItem("data") || "null");
        if (!data) {
            const [comments, status] = await Promise.all([
                fetch("https://api.github.com/repos/ymc0182/comments/discussions").then((r) => r.json()),
                fetch("/api/status").then((r) => r.json())
            ]);
            data = { ...status, commentsCount: comments.reduce((sum: number, item: any) => sum + item.comments, 0) };
            sessionStorage.setItem("data", JSON.stringify(data));
        }
        $("currentViews").textContent = data.data.views.toLocaleString();
        $("currentStatus").textContent = data.data.status;
        $("commentsCount").textContent = data.commentsCount;
    })().catch(() => {});
</script>
